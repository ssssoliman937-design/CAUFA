rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Players: everyone signed in can read (to rate + view cards).
    // Only the admin can create/edit/delete a player (name, position,
    // specialSkills, posters...).
    match /players/{playerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users: everyone signed in can read (progress table, comparisons).
    // A brand-new user creates their OWN doc on first login (app.js /
    // dashboard.js self-registration) — allowed as long as they can't
    // hand themselves the admin role. Existing docs: a user may update
    // only their own non-privileged rating-progress fields; only the
    // admin can change anyone's `role`. Deleting a user account is
    // admin-only (normally done via the Cloud Function's admin SDK,
    // which bypasses these rules entirely).
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid && !('role' in request.resource.data));
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
         !('role' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }

    // Votes: a user can only ever write their OWN vote docs; everyone
    // signed in can read (needed to build median stats + results).
    match /votes/{voteId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.voter_uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
